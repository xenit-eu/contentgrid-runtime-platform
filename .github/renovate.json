{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>xenit-eu/contentgrid-renovate-presets:renovate.json"
  ],
  "helm-values": {
    "managerFilePatterns": [
      "/(^|/)values\\.ya?ml$/",
      "/(^|/)contentgrid-rtp-helm/envs/[^/]+\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/xenit-eu/contentgrid-*",
        "ghcr.io/xenit-eu/kubectl"
      ],
      "groupName": "contentgrid",
      "pinDigests": true,
      "automerge": true
    },
    {
      "description": "ACC-3325: gateway is pinned on scw-prod",
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "contentgrid-rtp-helm/envs/scw-prod.yaml"
      ],
      "matchPackageNames": [
        "ghcr.io/xenit-eu/contentgrid-gateway"
      ],
      "groupName": null,
      "automerge": false
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "docker.xenit.eu/contentgrid/extensions/renditions/**"
      ],
      "groupName": "renditions extension",
      "pinDigests": true,
      "automerge": true
    },
    {
      "matchPackageNames": [
        "docker.xenit.eu/contentgrid/extensions/renditions/**"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "docker.io/prom/prometheus"
      ],
      "pinDigests": true
    }
  ]
}
